# Production profile for the Hetzner VPS (HZ-1). Install as /etc/tempo/api.env (root:tempo, mode 0640).
# Derived from scripts/deploy/fly/mcp-public.env. A test (tests/test_hz1_hetzner_deploy.py) keeps every
# key of that file here, except the three the HZ brief changes:
#   TEMPO_ASK_LOG_DIR            now a directory on the VPS.
#   TEMPO_MCP_ALLOWED_HOSTS      the Fly hostname is dropped. The host of TEMPO_PUBLIC_BASE_URL is
#                                always allowed, so no extra host is needed.
#   TEMPO_MCP_TRUST_FORWARDED    new key, set to false. See the client-identity note below.
#
# Rollback: unset TEMPO_MCP_ENABLED (every /mcp path answers 404 again), or drop
# TEMPO_MCP_MAX_SCAN_ROWS to return to the 1,000,000-row default.
#
# Measurements (from the Fly profile; macOS, not Linux; HZ-3 measures Linux):
# - Scan cap: 5,000,000 rows. The largest admitted files are 3.9M rows (POP107D/POP108D
#   *_grupe_localitate). POP107D/POP108D, their *_varste_* children and *_varste_judet
#   (8.7M-22M rows) stay refused.
# - Other TEMPO_MCP_* settings: the app defaults (one operation at a time, 10 s deadline).
# - DuckDB budgets (AQ-07A, macOS, generation 062bd2b0, TEMPO_DB_THREADS=1, scan cap 5M): the main
#   connection gets 128MB (app default 160MB) and the search sidecar 64MB (default 192MB). Same
#   benchmark answers as the defaults. Peak RSS did not fall measurably (cold chain 372-376 MiB).
#   The caps are a ceiling for heavier queries, not a measured saving.
# - Per-client windows: defaults 240 requests and 60 calls per minute per client key.
# - Content log cap: TEMPO_MCP_LOG_MAX_BYTES (default 256 MiB, one rotated .1 file). The app rotates
#   only mcp-calls.jsonl. logrotate rotates ask-chats.jsonl (scripts/deploy/hetzner/tempo-logrotate).
#
# Client identity behind Cloudflare Tunnel (HZ-1 finding, see README):
# The app reads Fly-Client-IP only on Fly (FLY_APP_NAME set; never set it here), then
# the first X-Forwarded-For entry when TRUST_FORWARDED is true (cloudflared keeps the client's own
# entries and appends the real address at the END, so the first entry is forgeable). Keep false.
# With false, the key is the peer address, which uvicorn sets from the right-most non-loopback
# X-Forwarded-For entry (the real visitor). HZ-2 checks this on the live tunnel.
# The global request window and the one-operation gate still apply.
TEMPO_MCP_ENABLED=true
TEMPO_PUBLIC_BASE_URL=https://api-ins.gov2.ro
TEMPO_PUBLIC_SITE_URL=https://ins.gov2.ro
TEMPO_CORS_ORIGINS=https://ins.gov2.ro
TEMPO_MCP_MAX_SCAN_ROWS=5000000
TEMPO_DB_MEMORY=128MB
TEMPO_SEARCH_MEMORY=64MB
# Hostname: TEMPO_PUBLIC_BASE_URL already allows api-ins.gov2.ro. Add more hosts here if a test
# hostname is used in HZ-3, for example: TEMPO_MCP_ALLOWED_HOSTS=test-ins.gov2.ro
TEMPO_MCP_TRUST_FORWARDED=false
# Own-key Ask (visitors' keys go to their provider through the app, never stored) and the content
# logs for the development phase (disclosed on the Ask page and in the MCP instructions).
TEMPO_ASK_BYOK_ENABLED=true
TEMPO_ASK_LOG_CHATS=true
TEMPO_MCP_LOG_CALLS=true
TEMPO_ASK_LOG_DIR=/var/log/tempo
