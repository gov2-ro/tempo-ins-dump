# Public MCP operator profile for the 512 MB Fly machine (AQ-01B, measured 2026-10-27:
# docs/plans/ask-and-public-mcp/remaining/aq-01b-linux-run-record.md). Nothing reads this file
# automatically. Apply it only with the owner's approval (`fly secrets set` / [env]).
#
# Rollback: unset TEMPO_MCP_ENABLED (every /mcp path answers 404 again), or drop
# TEMPO_MCP_MAX_SCAN_ROWS to return to the 1,000,000-row default.
#
# Tested limits:
# - Scan cap: 5,000,000 rows. The largest admitted files are 3.9M rows (POP107D/POP108D
#   *_grupe_localitate). POP107D/POP108D, their *_varste_* children and *_varste_judet
#   (8.7M–22M rows) stay refused.
# - Other TEMPO_MCP_* settings: the app defaults (one operation at a time, 10 s deadline).
# - TEMPO_DB_MEMORY: the 160MB app default.
TEMPO_MCP_ENABLED=true
TEMPO_PUBLIC_BASE_URL=https://api-ins.gov2.ro
TEMPO_PUBLIC_SITE_URL=https://ins.gov2.ro
TEMPO_CORS_ORIGINS=https://ins.gov2.ro
TEMPO_MCP_MAX_SCAN_ROWS=5000000
TEMPO_MCP_ALLOWED_HOSTS=tempo-ins-explorer.fly.dev
# Own-key Ask (visitors' keys go to their provider through the app, never stored) and the content
# logs for the development phase (disclosed on the Ask page and in the MCP instructions), on the
# /logs volume. Applied 2026-10-28 with the owner's approval.
TEMPO_ASK_BYOK_ENABLED=true
TEMPO_ASK_LOG_CHATS=true
TEMPO_MCP_LOG_CALLS=true
TEMPO_ASK_LOG_DIR=/logs
